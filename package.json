    "drizzle-orm": "^0.45.4",
    "isbot": "^5.1.36",
    "lucide-react": "^1.61.0",
    "motion": "^14.5.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
